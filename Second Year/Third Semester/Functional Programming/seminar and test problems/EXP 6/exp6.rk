#lang racket

(define dl '((1 2) ((3 (4) 5) (((6)))) (7)))

(define (atom? l)
  (and (not (null? l)) (not (pair? l))))

(define (deep-foldr op term nv l)
  (cond ((null? l) nv)
        ((atom? l) (term l))
        (else (op (deep-foldr op term nv (car l))
                  (deep-foldr op term nv (cdr l))))))

(define (tree? t)
  (or (null? t)
      (and (list? t)
           (= (length t) 3))
           (tree? (cadr t))
           (tree? (caddr t))))
(define empty-tree '())
(define (make-tree root left right) (list root left right))      
(define (make-leaf root) (make-tree root empty-tree empty-tree))
(define root-tree car)
(define left-tree cadr)
(define right-tree caddr)
(define empty-tree? null?)

(define t (make-tree 5
                     (make-tree 1
                                (make-tree 4
                                           '()
                                           (make-leaf 13))
                                (make-leaf 3))
                     (make-tree 8
                                (make-tree 0
                                           (make-leaf 10)
                                           (make-leaf 9))
                                (make-leaf 11))))


(define (tree-member? x t) (cond ((empty-tree? t) #f)
                                 ((equal? x (root-tree t)) #t)
                                 (else (or (tree-member? x (right-tree t)) (tree-member? x (left-tree t))))))

;(displayln (tree-member? 9 t)) ;-> #t
;(displayln (tree-member? 18 t)) ;-> #f

(define (depth1 t) (cond ((empty-tree? t) 0)
                         (else (max (+ 1 (depth1 (left-tree t))) (+ 1 (depth1 (right-tree t)))))))

(define (depth2 t) (deep-foldr (lambda (x acc) (max (+ x 1) acc)) (lambda (x) 0) 0 t))

;(displayln (depth1 t)) ;-> 4
;(displayln (depth2 t)) ;-> 4

(define (count-leaves t) (cond ((empty-tree? t) 0)
                               ((and (empty-tree? (left-tree t)) (empty-tree? (right-tree t))) 1)
                               (else (+ (count-leaves (left-tree t)) (count-leaves (right-tree t))))))

;(displayln (count-leaves t)) ;-> 5

(define (traverse t) (cond ((empty-tree? t) `())
                           ((and (empty-tree? (left-tree t)) (empty-tree? (right-tree t))) (list (root-tree t)))
                           (else (append (traverse (left-tree t)) (list (root-tree t)) (traverse (right-tree t))))))

;(displayln (traverse t)) ;->(4 13 1 3 5 10 0 9 8 11)


(define (level k t) (cond ((empty-tree? t) `())
                          ((zero? k) (list (root-tree t)))
                          (else (append (level (- k 1) (left-tree t)) (level (- k 1) (right-tree t))))))

;(displayln (level 1 t)); -> (1 8)
;(displayln (level 2 t)); -> (4 3 0 11)
;(displayln (level 4 t)); -> ()


; Associative Lists

(define (make-assoc f l)
  (map (lambda (x)
         (cons x (f x))) l))

(define assoc-list (make-assoc (lambda (x) (* x x)) '(1 2 3 4 5)))


(define (keys al) (cond ((null? al) `())
                        (else (append (list (caar al)) (keys (cdr al))))))

(define (values al) (cond ((null? al) `())
                          (else (append (list (cdar al)) (values (cdr al))))))

;(displayln (keys assoc-list)); -> (1 2 3 4 5)
;(displayln (values assoc-list)); -> (1 4 9 16 25)

(define (search k al) (cond ((null? al) #f)
                            ((equal? k (caar al)) (car al))
                            (else (search k (cdr al)))))

;(displayln (search 3 assoc-list)) ; -> ‘(3 . 9)
;(displayln (search 6 assoc-list)) ; -> #f

(define (delete k al) (cond ((null? al) al)
                            ((equal? k (caar al)) (cdr al))
                            (else (cons (car al) (delete k (cdr al))))))

;(displayln (delete 3 assoc-list)) ; -> '((1 . 1) (2 . 4) (4 . 16) (5 . 25))
;(displayln (delete 6 assoc-list)) ; -> '((1 . 1) (2 . 4) (3 . 9) (4 . 16) (5 . 25))

(define (add-assoc k v al) (cond ((null? al) (cons k v))
                                 ((equal? k (caar al)) (cons (cons k v) (cdr al)))
                                 (else (cons (car al) (add-assoc k v (cdr al))))))

;(displayln (add-assoc 6 36 assoc-list)) ; -> '((1 . 1) (2 . 4) (3 . 9) (4 . 16) (5 . 25) (6 . 36))
;(displayln (add-assoc 4 36 assoc-list)) ; -> '((1 . 1) (2 . 4) (3 . 9) (4 . 36) (5 . 25))

(define (timesIn x l) (cond ((null? l) 0)
                            ((equal? x (car l)) (+ 1 (timesIn x (cdr l))))
                            (else (timesIn x (cdr l)))))

(define (unique l) (cond ((null? l) `())
                         (else (cons (car l) (unique (filter (lambda (x) (not (equal? x (car l)))) (cdr l)))))))

(define (histogram l) (unique (map (lambda (x) (cons x (timesIn x l))) l)))

;(displayln (histogram '(8 7 1 7 8 2 2 8 2 7 8 1))) ; -> '((8 . 4) (7 . 3) (1 . 2) (2 . 3))

; Streams

(define-syntax cons-stream
  (syntax-rules () ((cons-stream h t)
                    (cons h (delay t)))))

(define head car)
(define (tail s) (force (cdr s))) 

(define (integer-from n) (cons-stream n (integer-from (+ n 1))))

(define (take n stream) (cond ((zero? n) `())
                              (else (append (list (head stream)) (take (- n 1) (tail stream))))))

(define nats (integer-from 1))
(define nats0 (integer-from 0))

(define (map-stream f stream) (cons-stream (f (head stream)) (map-stream f (tail stream))))

(define (fib-stream a b) (cons-stream a (fib-stream b (+ a b))))
(define fib (fib-stream 0 1))
















