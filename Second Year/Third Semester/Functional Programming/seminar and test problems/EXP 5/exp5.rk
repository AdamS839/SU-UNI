#lang racket

(define (foldr op nv l) (cond ((null? l) nv)
                              (else (op (car l) (foldr op nv (cdr l))))))

(define (foldl op nv l) (cond ((null? l) nv)
                              (else (foldl op (op nv (car l)) (cdr l)))))

;(define (least lst) (apply min lst))
(define (least lst) (foldr (lambda (x acc) (if (< x acc) x acc)) (car lst) lst))

; (displayln (least '(4 5 1 8 3 -9 -4 1 4))) ;-> -9

(define (isMember? i lst) (cond ((null? lst) #f)
                                ((equal? i (car lst)) #t)
                                (else (isMember? i (cdr lst)))))

(define (unique l) (cond ((null? l) `())
                         ((isMember? (car l) (cdr l)) (unique (cdr l)))
                         (else (append (list (car l)) (unique (cdr l))))))

;(displayln (unique '(1 3 6 2 2 8 1))) ; -> ‘(3 6 2 8 1)
;(displayln (unique '(0 "asd" 2 "asd" "1" 0 4))) ;->'(2 "asd" "1" 0 4)

(define (union l1 l2) (cond ((null? l1) l2)
                            ((null? l2) l1)
                            ((isMember? (car l1) l2) (union (cdr l1) l2))
                            (else (append (list (car l1)) (union (cdr l1) l2)))))

;(displayln (union '(1 2 3 4) '(5 2 3 1 7))) ;->'(4 5 2 3 1 7)

(define (intersection l1 l2) (cond ((null? l1) `())
                                   ((null? l2) `())
                                   ((isMember? (car l1) l2) (append (list (car l1)) (intersection (cdr l1) l2)))
                                   (else (intersection (cdr l1) l2))))

;(displayln (intersection '(1 2 3 4) '(5 2 3 1 7))) ;-> `(1 2 3)

(define (insert x l) (cond ((null? l) (list x))
                           ((<= x (car l)) (append (list x) l))
                           (else (append (list (car l)) (insert x (cdr l))))))

;(displayln (insert 5 `(1 2 3 4 6 7))) ;-> '(1 2 3 4 5 6 7)

(define (insertion-sort l) (foldr (lambda (x acc) (insert x acc)) `() l))

;(displayln (insertion-sort '(1 5 5 8 2 4 1 2 9 4 8))) ;->'(1 1 2 2 4 4 5 5 8 8 9)

(define (find-interval . v) (- (apply max v) (apply min v)))

;(displayln (find-interval 2 5 8 -2)) ;-> 10

(define (min-lex-two a b) (if (string<? a b) a b))

(define (min-lex x . xs) (cond ((null? xs) x)
                               (else (min-lex-two x (apply min-lex xs)))))

;(displayln (min-lex "asd" "asdd" "azcesd")) ;->"asd"

(define (^2 x) (* x x))
(define (succ x) (+ x 1))

(define (compose-all2 . xs) (if (null? xs) (lambda (x) x)
                                (lambda (x) ((car xs) ((apply compose-all2 (cdr xs)) x)))))

;(displayln ((compose-all2 ^2 succ succ) 5)) ;-> 49

;------ Deep Lists

(define dl '((1 2) ((3 (4) 5) (((6)))) (7)))

(define (atom? l)
  (and (not (null? l)) (not (pair? l))))

(define (deep-foldr op term nv l)
  (cond ((null? l) nv)
        ((atom? l) (term l))
        (else (op (deep-foldr op term nv (car l))
                  (deep-foldr op term nv (cdr l))))))

(define (deep-map f l) (cond ((null? l) `())
                             ((atom? l) (f l))
                             (else (cons (deep-map f (car l)) (deep-map f (cdr l))))))

;(displayln (deep-map (lambda (x) (* x x)) dl)); -> '((1 4) ((9 (16) 25) (((36)))) (49))

(define (deep-filter p? l) (cond ((null? l) `())
                                 ((atom? l) (if (p? l) l `()))
                                 (else (cons (deep-filter p? (car l)) (deep-filter p? (cdr l))))))

;(displayln (deep-filter even? dl)); -> '((2) (((4)) (((6)))) ())


(define (deep-member? x l) (cond ((null? l) #f)
                                 ((atom? l) (if (= x l) #t #f))
                                 (else (or (deep-member? x (car l)) (deep-member? x (cdr l))))))

;(displayln (deep-member? 7 dl)); -> #t
;(displayln (deep-member? 18 dl)); -> #f


;--- Binary Trees

(define (tree? t)
  (or (null? t)
      (and (list? t)
           (= (length t) 3))
           (tree? (cadr t))
           (tree? (caddr t))))

(define empty-tree '())
(define (make-tree root left right) (list root left right))      
(define (make-leaf root) (make-tree root empty-tree empty-tree))
(define root-tree car)
(define left-tree cadr)
(define right-tree caddr)
(define empty-tree? null?)

; tree :

(define t (make-tree 5
                     (make-tree 1
                                (make-tree 4
                                           '()
                                           (make-leaf 13))
                                (make-leaf 3))
                     (make-tree 8
                                (make-tree 0
                                           (make-leaf 10)
                                           (make-leaf 9))
                                (make-leaf 11))))



(define (depth t) (cond ((empty-tree? t) 0)
                        (else (max (+ 1 (depth (left-tree t))) (+ 1 (depth (right-tree t)))))))

(define (depth-foldr t) (deep-foldr (lambda (l r) (max (+ l 1) r)) (lambda (x) 0) 0 t))

;(displayln (depth-foldr t)); -> 4

(define (count-leaves t) (cond ((empty-tree? t) 0)
                               ((and (null? (right-tree t)) (null? (left-tree t))) 1)
                               (else (+ (count-leaves (left-tree t)) (count-leaves (right-tree t))))))


;(displayln (count-leafs t)) ;-> 5


(define (traverse t) (cond ((empty-tree? t) `())
                           ((and (empty-tree? (left-tree t)) (empty-tree? (right-tree t))) (list (root-tree t)))
                           (else (append (traverse (left-tree t)) (list (root-tree t)) (traverse (right-tree t))))))

;(displayln (traverse t)) ; -> '(4 13 1 3 5 10 0 9 8 11)


(define (level k t) (cond ((empty-tree? t) `())
                          ((zero? k) (list (root-tree t)))
                          (else (append (level (- k 1) (left-tree t)) (level (- k 1) (right-tree t))))))


(displayln (level 1 t)); -> (1 8)
(displayln (level 2 t) ); -> '(4 3 0 11)








         